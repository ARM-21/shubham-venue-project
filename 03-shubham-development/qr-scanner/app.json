{
  "expo": {
    "name": "Shubham Scan",
    "slug": "qr-scanner",
    "version": "1.0.0",
    "sourceRoot": "app",
    "orientation": "portrait",
    "icon": "./assets/images/shubham-mono.png",
    "scheme": "qrscanner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arm21.qrscanner",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIUserInterfaceStyle": "Automatic",
        "NSUserNotificationUsageDescription": "We need your permission to send notifications about scanner assignments"
      },
      "icon": "./assets/images/shubham-mono.png"
    },
    "android": {
      "adaptiveIcon": {
             "foregroundImage": "./assets/images/shubham-logo.png",
        "backgroundColor": "#FFFFFF"
            },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.arm21.qrscanner",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/shubham-mono.png",
          "color": "#8b3a3a"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/shubham-logo.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundImage": "./assets/images/shubham-logo.png",
          "backgroundResizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/shubham-logo.png",
            "backgroundImage": "./assets/images/shubham-logo.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "21631496-c0e2-4052-a6b0-1f8624e36118"
      }
    }
  }
}
