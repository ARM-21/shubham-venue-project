{
  "expo": {
    "name": "Shubham QR Scanner",
    "slug": "qr-scanner",
    "version": "1.0.0",
    "sourceRoot": "app",
    "orientation": "portrait",
    "icon": "./assets/images/shubham-mono.png",
    "scheme": "qrscanner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arm21.qrscanner",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/images/shubham-mono.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/shubham-logo.png",
        "backgroundImage": "./assets/images/shubham-bg.png",
        "monochromeImage": "./assets/images/shubham-mono.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.arm21.qrscanner"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/shubham-logo.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundImage": "./assets/images/shubham-logo.png",
          "backgroundResizeMode": "contain",
          "dark": {
            "image": "./assets/images/shubham-logo.png",
            "backgroundImage": "./assets/images/shubham-logo.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "21631496-c0e2-4052-a6b0-1f8624e36118"
      }
    }
  }
}
