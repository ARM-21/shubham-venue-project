# ============================================================================
# Local Environment Variables - Copy this file to .env.local and fill in values
# ============================================================================

MONGODB_URI=mongodb://localhost:27017/shubham

NODE_ENV=development
PORT=5000

SESSION_NAME=shubham.sid
SESSION_SECRET=your-super-secret-key-here-change-in-production
SESSION_TTL_SECONDS=1209600
SESSION_COOKIE_MAX_AGE_MS=1209600000
TRUST_PROXY_HOPS=1

# Comma-separated origins for CORS (dev + prod)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_AVATAR_FOLDER=avatars

# Branding
DEFAULT_BRANDING_LOGO_KEY=branding/logo.png
DEFAULT_BRANDING_LOGO_URL=https://your-bucket.s3.amazonaws.com/branding/logo.png

# Payment Gateways - Khalti
KHALTI_SECRET_KEY=your-khalti-secret-key
KHALTI_RETURN_URL=http://localhost:3000/payment/khalti-success
KHALTI_WEBSITE_URL=http://localhost:3000
KHALTI_TICKET_RETURN_URL=http://localhost:3000/ticket/khalti-callback

# Payment Gateways - eSewa
ESEWA_PRODUCT_CODE=your-esewa-product-code
ESEWA_SECRET_KEY=your-esewa-secret-key
ESEWA_INIT_URL=https://uat.esewa.com.np/epay/main
ESEWA_STATUS_URL=https://uat.esewa.com.np/epay/transrec
ESEWA_BOOKING_SUCCESS_URL=http://localhost:3000/payment/esewa-success
ESEWA_BOOKING_FAILURE_URL=http://localhost:3000/payment/esewa-failure
ESEWA_TICKET_SUCCESS_URL=http://localhost:3000/ticket/esewa-success
ESEWA_TICKET_FAILURE_URL=http://localhost:3000/ticket/esewa-failure

# Email Configuration (SMTP - Optional, use either SMTP or Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
SUPPORT_EMAIL=support@shubham-venue.me

# Resend Email Service (Get your key from https://resend.com/api-keys)
# IMPORTANT: You need to set this for email functionality to work
RESEND_KEY=re_your_actual_resend_api_key_here

# Event Configuration
REFUND_FORM_URL=https://docs.google.com/forms/d/your-form-id/viewform

# AI/RAG Configuration
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key
